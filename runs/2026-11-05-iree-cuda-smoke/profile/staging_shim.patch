+// N transfer commands in ONE command buffer, one queue submission, one wait — what the
+// runtime's iree_hal_device_transfer_range does for a single copy (buffer_transfer.c), for a batch:
+// each submission + wait costs 2–4 ms on the CUDA HAL, so 600 of them were 1.3–1.6 s a step.
+static iree_status_t ffi_transfer_and_wait(iree_hal_device_t* device, iree_host_size_t count,
+                                           const iree_hal_transfer_command_t* commands) {
+  if (count == 0) return iree_ok_status();
+  iree_hal_command_buffer_t* cb = NULL;
+  IREE_RETURN_IF_ERROR(iree_hal_create_transfer_command_buffer(
+      device, IREE_HAL_COMMAND_BUFFER_MODE_ONE_SHOT | IREE_HAL_COMMAND_BUFFER_MODE_ALLOW_INLINE_EXECUTION,
+      IREE_HAL_QUEUE_AFFINITY_ANY, count, commands, &cb));
