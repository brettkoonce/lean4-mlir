+static iree_status_t ensure_staging(iree_ffi_session_t* sess, iree_device_size_t in_bytes,
+                                    iree_device_size_t out_bytes) {
+  iree_hal_allocator_t* alloc = iree_hal_device_allocator(sess->device);
+  const iree_hal_buffer_params_t host_params = {
+    .type = IREE_HAL_MEMORY_TYPE_HOST_LOCAL | IREE_HAL_MEMORY_TYPE_DEVICE_VISIBLE,
+    .usage = IREE_HAL_BUFFER_USAGE_TRANSFER | IREE_HAL_BUFFER_USAGE_MAPPING,
+  };
+  const iree_hal_buffer_params_t dev_params = {
+    .type = IREE_HAL_MEMORY_TYPE_DEVICE_LOCAL,
+    .usage = IREE_HAL_BUFFER_USAGE_DEFAULT,
+  };
+  if (in_bytes > sess->stage_in_cap) {
+    if (sess->stage_in_host) { iree_hal_buffer_release(sess->stage_in_host); sess->stage_in_host = NULL; }
+    if (sess->stage_in_dev) { iree_hal_buffer_release(sess->stage_in_dev); sess->stage_in_dev = NULL; }
+    sess->stage_in_cap = 0;
+    IREE_RETURN_IF_ERROR(iree_hal_allocator_allocate_buffer(alloc, host_params, in_bytes, &sess->stage_in_host));
+    IREE_RETURN_IF_ERROR(iree_hal_allocator_allocate_buffer(alloc, dev_params, in_bytes, &sess->stage_in_dev));
+    sess->stage_in_cap = in_bytes;
+  }
+  if (out_bytes > sess->stage_out_cap) {
+    if (sess->stage_out_host) { iree_hal_buffer_release(sess->stage_out_host); sess->stage_out_host = NULL; }
+    sess->stage_out_cap = 0;
+    IREE_RETURN_IF_ERROR(iree_hal_allocator_allocate_buffer(alloc, host_params, out_bytes, &sess->stage_out_host));
+    sess->stage_out_cap = out_bytes;
+  }
+  return iree_ok_status();
 }
 
