+// iree_hal_device_transfer_d2h per output — costs a pinned host staging allocation and free
+// (cuMemHostAlloc / cuMemFreeHost, ~1.7 ms each, both synchronizing) PER TENSOR on the CUDA HAL.
+// A verified train step has 300–600 of each (θ, m, v, per tensor), so a MobileNetV2 step spent
+// 2 s of its 3.7 s there and the GPU sat idle (nsys, ares, 2026-11-05). Here all inputs are
+// packed into one pinned host buffer, moved in ONE transfer into one device buffer and bound as
+// 64-byte-aligned subspans of it; outputs are copied device→pinned host one transfer each (no
+// allocation) and read off the mapping. Same code on the CPU device (everything is host memory,
+// the transfers are memcpys).
+#define IREE_FFI_ALIGN 64
+static iree_device_size_t ffi_align(iree_device_size_t n) {
+  return (n + IREE_FFI_ALIGN - 1) / IREE_FFI_ALIGN * IREE_FFI_ALIGN;
+}
 
