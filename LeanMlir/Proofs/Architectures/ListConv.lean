module

public import LeanMlir.Proofs.Architectures.ConvIndex
public import LeanMlir.Proofs.Foundation.ListDot
import Mathlib.Algebra.BigOperators.Field

@[expose] public section

/-! # Kernel-checked integer tables for conv and max-pool certificates

`Foundation/ListDot` makes a 784-term dense dot product one kernel evaluation. This file does
the same for the tables a CONV-net certificate needs at the full 28×28 input, where one
`norm_num` call per cell (1,568 cells per conv, 392 pool windows) does not scale.

Certificate data lives in nested `List ℤ` numerators over one denominator per table (pixels
`k/255`, weights `k/128`), read through the `ℕ`-indexed accessors `g2`/`g3`/`g4`. A real tensor
or kernel is such a table over its denominator (`tabR`, `kerR`). Each whole-table fact is ONE
`decide +kernel` of a `Bool` built from the bounded quantifiers `allN`/`anyN` over an integer
evaluator, and a bridge lemma, proved once here, transports it to the `ℝ` statement:

* `conv2d_tab`: `conv2d` of tables is the table `convCellZ` computes;
* `relu_flatten_tabR`, `relu_ite_tabR`: `relu` of a table is the table of `max · 0`
  (`reluZ`), with no check;
* `maxPoolFlat_relu_tab`: the pooled feature vector, as a flat `getD` list ready for
  `sum_getD_div`;
* `tabR_abs_le`, `tabR_lt_abs`, `kerR_abs_le`, `abs_getD_div_le`: entrywise bounds and margins;
* `maxPool2MarginQUpTo_of_poolCertZ`: the pool margin up to twins, one certificate per window
  (dead, or a designated cell with every other cell a twin or below it by the margin);
* `convPatchEq_of_zeroTwinZ`, `convPatchEq2_of_blankTwinZ`: the twins a blank image region
  gives, one conv deep and two.

`decide +kernel` is the kernel evaluator, not `native_decide`: every lemma here and every use
is `propext`/`Classical.choice`/`Quot.sound` only. Used by `Trained.CnnDescent` and
`Trained.CnnDescentConv1` (generated by `scripts/certs/trained_cnn_descent.py`).
-/

namespace Proofs

open scoped BigOperators

-- ════════════════════════════════════════════════════════════════
-- § Bounded sums and quantifiers the kernel evaluates
-- ════════════════════════════════════════════════════════════════

/-- `Σ_{i<n} f i` by structural recursion, the shape the kernel evaluates. -/
def sumN : ℕ → (ℕ → ℤ) → ℤ
  | 0, _ => 0
  | n + 1, f => sumN n f + f n

theorem sumN_cast (n : ℕ) (f : ℕ → ℤ) : ((sumN n f : ℤ) : ℝ) = ∑ i : Fin n, (f i : ℝ) := by
  induction n with
  | zero => simp [sumN]
  | succ n ih => rw [Fin.sum_univ_castSucc]; simp [sumN, ih]

/-- `∀ i < n, p i` as a `Bool`. -/
def allN : ℕ → (ℕ → Bool) → Bool
  | 0, _ => true
  | n + 1, p => allN n p && p n

theorem allN_spec {n : ℕ} {p : ℕ → Bool} (h : allN n p = true) : ∀ i < n, p i = true := by
  induction n with
  | zero => intro i hi; omega
  | succ n ih =>
    rw [allN, Bool.and_eq_true] at h
    intro i hi
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h' | rfl
    · exact ih h.1 i h'
    · exact h.2

/-- `∃ i < n, p i` as a `Bool`. -/
def anyN : ℕ → (ℕ → Bool) → Bool
  | 0, _ => false
  | n + 1, p => anyN n p || p n

theorem anyN_spec {n : ℕ} {p : ℕ → Bool} (h : anyN n p = true) : ∃ i < n, p i = true := by
  induction n with
  | zero => simp [anyN] at h
  | succ n ih =>
    rw [anyN, Bool.or_eq_true] at h
    rcases h with h | h
    · obtain ⟨i, hi, hp⟩ := ih h
      exact ⟨i, Nat.lt_succ_of_lt hi, hp⟩
    · exact ⟨n, Nat.lt_succ_self n, h⟩

-- ════════════════════════════════════════════════════════════════
-- § Nested-list accessors and the real tables over them
-- ════════════════════════════════════════════════════════════════

/-- Entry `(i, j)` of a list of rows; `0` out of range. -/
def g2 (g : List (List ℤ)) (i j : ℕ) : ℤ := (g.getD i []).getD j 0

/-- Entry `(c, i, j)` of a list of channels of rows; `0` out of range. -/
def g3 (g : List (List (List ℤ))) (c i j : ℕ) : ℤ := g2 (g.getD c []) i j

/-- Entry `(o, c, i, j)` of a kernel stored output channel by output channel. -/
def g4 (g : List (List (List (List ℤ)))) (o c i j : ℕ) : ℤ := g3 (g.getD o []) c i j

/-- `k z`, with `z` evaluated first. The kernel evaluates by name: a term used twice is
    evaluated twice, and `max a b = if a ≤ b then b else a` doubles the work at every nesting
    level. Matching on `z` forces it once and hands `k` the literal. -/
def forceZ {α : Type} (z : ℤ) (k : ℤ → α) : α :=
  match z with
  | .ofNat 0 => k (.ofNat 0)
  | .ofNat (n + 1) => k (.ofNat (n + 1))
  | .negSucc 0 => k (.negSucc 0)
  | .negSucc (n + 1) => k (.negSucc (n + 1))

theorem forceZ_eq {α : Type} (z : ℤ) (k : ℤ → α) : forceZ z k = k z := by
  rcases z with (_ | n) | (_ | n) <;> rfl

/-- `max a b`, each argument evaluated once. -/
def maxZ (a b : ℤ) : ℤ := forceZ a fun a' => forceZ b fun b' => if a' ≤ b' then b' else a'

theorem maxZ_eq (a b : ℤ) : maxZ a b = max a b := by
  rw [maxZ, forceZ_eq, forceZ_eq, max_def]

/-- `max z 0`, with `z` evaluated once. -/
def posZ : ℤ → ℤ
  | .ofNat n => .ofNat n
  | .negSucc _ => 0

theorem posZ_eq (z : ℤ) : posZ z = max z 0 := by
  rcases z with n | n
  · exact (max_eq_left (Int.natCast_nonneg n)).symm
  · exact (max_eq_right (Int.negSucc_lt_zero n).le).symm

/-- The entrywise `max · 0` of an integer table: `relu` on numerators. -/
def reluZ (x : ℕ → ℕ → ℕ → ℤ) : ℕ → ℕ → ℕ → ℤ := fun c i j => posZ (x c i j)

/-- The real tensor with numerators `xZ` over the denominator `d`. -/
noncomputable def tabR {c h w : ℕ} (xZ : ℕ → ℕ → ℕ → ℤ) (d : ℝ) : Tensor3 c h w :=
  fun ci hi wi => (xZ ci hi wi : ℝ) / d

/-- The real conv kernel with numerators `WZ` over the denominator `d`. -/
noncomputable def kerR {oc ic kH kW : ℕ} (WZ : ℕ → ℕ → ℕ → ℕ → ℤ) (d : ℝ) : Kernel4 oc ic kH kW :=
  fun o c kh kw => (WZ o c kh kw : ℝ) / d

/-- A `getD` read of a list whose entries are all within `n` is within `n`. -/
theorem abs_getD_le (xs : List ℤ) (n : ℤ) (hn : 0 ≤ n) (h : ∀ z ∈ xs, -n ≤ z ∧ z ≤ n) (i : ℕ) :
    |xs.getD i 0| ≤ n := by
  rw [List.getD_eq_getElem?_getD, abs_le]
  cases hget : xs[i]? with
  | none => simpa using hn
  | some z => simpa using h z (List.mem_of_getElem? hget)

/-- The scaled form a weight-matrix bound instantiates, one list per column. -/
theorem abs_getD_div_le (xs : List ℤ) (n : ℤ) (hn : 0 ≤ n) (h : ∀ z ∈ xs, -n ≤ z ∧ z ≤ n)
    {d B : ℝ} (hd : 0 < d) (hB : (n : ℝ) / d ≤ B) (i : ℕ) : |(xs.getD i 0 : ℝ) / d| ≤ B := by
  have hz : |(xs.getD i 0 : ℝ)| ≤ (n : ℝ) := by exact_mod_cast abs_getD_le xs n hn h i
  rw [abs_div, abs_of_pos hd]
  exact (div_le_div_of_nonneg_right hz hd.le).trans hB

-- ════════════════════════════════════════════════════════════════
-- § Entrywise bounds and margins of a table
-- ════════════════════════════════════════════════════════════════

/-- Every entry of a `c×h×w` table is within `n`. -/
def absLeZ (c h w : ℕ) (xZ : ℕ → ℕ → ℕ → ℤ) (n : ℤ) : Bool :=
  allN c fun ci => allN h fun hi => allN w fun wi => decide (((xZ ci hi wi).natAbs : ℤ) ≤ n)

theorem tabR_abs_le {c h w : ℕ} {xZ : ℕ → ℕ → ℕ → ℤ} {n : ℤ} {d a : ℝ}
    (hchk : absLeZ c h w xZ n = true) (hd : 0 < d) (ha : (n : ℝ) / d ≤ a)
    (ci : Fin c) (hi : Fin h) (wi : Fin w) : |(tabR xZ d : Tensor3 c h w) ci hi wi| ≤ a := by
  have hz := of_decide_eq_true
    (allN_spec (allN_spec (allN_spec hchk ci ci.2) hi hi.2) wi wi.2)
  rw [Int.natCast_natAbs] at hz
  have hz' : |(xZ ci hi wi : ℝ)| ≤ (n : ℝ) := by exact_mod_cast hz
  show |(xZ ci hi wi : ℝ) / d| ≤ a
  rw [abs_div, abs_of_pos hd]
  exact (div_le_div_of_nonneg_right hz' hd.le).trans ha

/-- Every entry of an `oc×ic×kH×kW` kernel table is within `n`. -/
def kerAbsLeZ (oc ic kH kW : ℕ) (WZ : ℕ → ℕ → ℕ → ℕ → ℤ) (n : ℤ) : Bool :=
  allN oc fun o => absLeZ ic kH kW (WZ o) n

theorem kerR_abs_le {oc ic kH kW : ℕ} {WZ : ℕ → ℕ → ℕ → ℕ → ℤ} {n : ℤ} {d a : ℝ}
    (hchk : kerAbsLeZ oc ic kH kW WZ n = true) (hd : 0 < d) (ha : (n : ℝ) / d ≤ a)
    (o : Fin oc) (cc : Fin ic) (kh : Fin kH) (kw : Fin kW) :
    |(kerR WZ d : Kernel4 oc ic kH kW) o cc kh kw| ≤ a :=
  tabR_abs_le (allN_spec hchk o o.2) hd ha cc kh kw

/-- Every entry of a `c×h×w` table is beyond `n` in absolute value. -/
def ltAbsZ (c h w : ℕ) (xZ : ℕ → ℕ → ℕ → ℤ) (n : ℤ) : Bool :=
  allN c fun ci => allN h fun hi => allN w fun wi => decide (n < ((xZ ci hi wi).natAbs : ℤ))

theorem tabR_lt_abs {c h w : ℕ} {xZ : ℕ → ℕ → ℕ → ℤ} {n : ℤ} {d r : ℝ}
    (hchk : ltAbsZ c h w xZ n = true) (hd : 0 < d) (hr : r ≤ (n : ℝ) / d)
    (ci : Fin c) (hi : Fin h) (wi : Fin w) : r < |(tabR xZ d : Tensor3 c h w) ci hi wi| := by
  have hz := of_decide_eq_true
    (allN_spec (allN_spec (allN_spec hchk ci ci.2) hi hi.2) wi wi.2)
  rw [Int.natCast_natAbs] at hz
  have hz' : (n : ℝ) < |(xZ ci hi wi : ℝ)| := by exact_mod_cast hz
  show r < |(xZ ci hi wi : ℝ) / d|
  rw [abs_div, abs_of_pos hd]
  exact hr.trans_lt (div_lt_div_of_pos_right hz' hd)

-- ════════════════════════════════════════════════════════════════
-- § Convolution of tables
-- ════════════════════════════════════════════════════════════════

/-- The zero-padded read `convPad` on numerators: one channel's `h×w` table `x`, kernel offset
    `(kh, kw)`, output cell `(hi, wi)`. -/
def padZ (kH kW h w : ℕ) (x : ℕ → ℕ → ℤ) (kh kw hi wi : ℕ) : ℤ :=
  if (kH - 1) / 2 ≤ kh + hi ∧ kh + hi - (kH - 1) / 2 < h ∧
      (kW - 1) / 2 ≤ kw + wi ∧ kw + wi - (kW - 1) / 2 < w then
    x (kh + hi - (kH - 1) / 2) (kw + wi - (kW - 1) / 2)
  else 0

theorem convPad_tabR {ic h w : ℕ} (kH kW : ℕ) (xZ : ℕ → ℕ → ℕ → ℤ) (d : ℝ)
    (c : Fin ic) (kh : Fin kH) (kw : Fin kW) (hi : Fin h) (wi : Fin w) :
    convPad kH kW (tabR xZ d : Tensor3 ic h w) c kh kw hi wi =
      (padZ kH kW h w (xZ c) kh kw hi wi : ℝ) / d := by
  unfold convPad padZ
  by_cases hp : (kH - 1) / 2 ≤ kh.val + hi.val ∧ kh.val + hi.val - (kH - 1) / 2 < h ∧
      (kW - 1) / 2 ≤ kw.val + wi.val ∧ kw.val + wi.val - (kW - 1) / 2 < w
  · rw [dite_eq_left hp, ite_eq_left hp]; rfl
  · rw [dite_eq_right hp, ite_eq_right hp, Int.cast_zero, zero_div]

/-- One output channel's conv sum at cell `(hi, wi)`, on numerators, bias excluded. -/
def convCoreZ (ic kH kW h w : ℕ) (W : ℕ → ℕ → ℕ → ℤ) (x : ℕ → ℕ → ℕ → ℤ) (hi wi : ℕ) : ℤ :=
  sumN ic fun c => sumN kH fun kh => sumN kW fun kw =>
    W c kh kw * padZ kH kW h w (x c) kh kw hi wi

theorem conv2d_cast {ic oc h w kH kW : ℕ} (WZ : ℕ → ℕ → ℕ → ℕ → ℤ) (b : Vec oc)
    (xZ : ℕ → ℕ → ℕ → ℤ) (dw dx : ℝ) (o : Fin oc) (hi : Fin h) (wi : Fin w) :
    conv2d (kerR WZ dw : Kernel4 oc ic kH kW) b (tabR xZ dx : Tensor3 ic h w) o hi wi =
      b o + (convCoreZ ic kH kW h w (WZ o) xZ hi wi : ℝ) / (dw * dx) := by
  rw [conv2d_eq_convPad]
  congr 1
  rw [convCoreZ, sumN_cast, Finset.sum_div]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [sumN_cast, Finset.sum_div]
  refine Finset.sum_congr rfl fun kh _ => ?_
  rw [sumN_cast, Finset.sum_div]
  refine Finset.sum_congr rfl fun kw _ => ?_
  rw [convPad_tabR, Int.cast_mul]
  show (WZ o c kh kw : ℝ) / dw * _ = _
  ring

/-- One conv output cell on numerators over the output denominator: the bias numerator `bN`
    plus `mc` times the conv sum. -/
def convCellZ (ic kH kW h w : ℕ) (bN mc : ℤ) (W : ℕ → ℕ → ℕ → ℤ) (x : ℕ → ℕ → ℕ → ℤ)
    (hi wi : ℕ) : ℤ :=
  bN + mc * convCoreZ ic kH kW h w W x hi wi

/-- The whole conv output is the table `cZ`. -/
def convTabZ (oc ic kH kW h w : ℕ) (bN : ℕ → ℤ) (mc : ℤ) (WZ : ℕ → ℕ → ℕ → ℕ → ℤ)
    (xZ cZ : ℕ → ℕ → ℕ → ℤ) : Bool :=
  allN oc fun o => allN h fun hi => allN w fun wi =>
    decide (convCellZ ic kH kW h w (bN o) mc (WZ o) xZ hi wi = cZ o hi wi)

/-- **`conv2d` of tables is a table.** Weights over `dw`, input over `dx`, output over `D`; the
    bias is any vector whose entries are the numerators `bN` over `D`, and `mc/D = 1/(dw·dx)`.
    The 1,568 cells of a 2-channel 28×28 conv are one kernel evaluation of `convTabZ`. -/
theorem conv2d_tab {ic oc h w kH kW : ℕ} {WZ : ℕ → ℕ → ℕ → ℕ → ℤ} {b : Vec oc} {bN : ℕ → ℤ}
    {xZ cZ : ℕ → ℕ → ℕ → ℤ} {dw dx D : ℝ} {mc : ℤ}
    (hb : ∀ o : Fin oc, b o = (bN o : ℝ) / D) (hc : (mc : ℝ) / D = 1 / (dw * dx))
    (hchk : convTabZ oc ic kH kW h w bN mc WZ xZ cZ = true) :
    conv2d (kerR WZ dw : Kernel4 oc ic kH kW) b (tabR xZ dx : Tensor3 ic h w) = tabR cZ D := by
  funext o hi wi
  have hz := of_decide_eq_true
    (allN_spec (allN_spec (allN_spec hchk o o.2) hi hi.2) wi wi.2)
  rw [conv2d_cast, hb]
  show _ = (cZ o hi wi : ℝ) / D
  rw [← hz, convCellZ, Int.cast_add, Int.cast_mul, add_div, mul_div_right_comm, hc]
  ring

-- ════════════════════════════════════════════════════════════════
-- § ReLU and the 2×2 max pool of tables
-- ════════════════════════════════════════════════════════════════

theorem relu_tabR_cell {c h w : ℕ} (cZ : ℕ → ℕ → ℕ → ℤ) {D : ℝ} (hD : 0 < D)
    (ci : Fin c) (hi : Fin h) (wi : Fin w) :
    max ((tabR cZ D : Tensor3 c h w) ci hi wi) 0 = (tabR (reluZ cZ) D : Tensor3 c h w) ci hi wi := by
  show max ((cZ ci hi wi : ℝ) / D) 0 = ((posZ (cZ ci hi wi) : ℤ) : ℝ) / D
  rw [posZ_eq, Int.cast_max, Int.cast_zero, ← max_div_div_right hD.le, zero_div]

/-- `relu` of a table, in the `if · > 0` form, is the table of `max · 0`. -/
theorem relu_ite_tabR {c h w : ℕ} (cZ : ℕ → ℕ → ℕ → ℤ) {D : ℝ} (hD : 0 < D) :
    (fun ci hi wi => if (tabR cZ D : Tensor3 c h w) ci hi wi > 0 then
      (tabR cZ D : Tensor3 c h w) ci hi wi else 0) = tabR (reluZ cZ) D := by
  funext ci hi wi
  rw [← relu_tabR_cell cZ hD]
  exact (max_def_lt' _ 0).symm

/-- `relu` of a flattened table is the flattened table of `max · 0`. -/
theorem relu_flatten_tabR {c h w : ℕ} (cZ : ℕ → ℕ → ℕ → ℤ) {D : ℝ} (hD : 0 < D) :
    relu (c * h * w) (Tensor3.flatten (tabR cZ D : Tensor3 c h w)) =
      Tensor3.flatten (tabR (reluZ cZ) D : Tensor3 c h w) := by
  funext k
  obtain ⟨ci, hi, wi, rfl⟩ := t3Idx_surj k
  rw [relu_apply_eq_max, flatten_t3Idx, flatten_t3Idx, relu_tabR_cell cZ hD]

/-- The max of the 2×2 window `(ho, wo)` of one channel, on numerators. -/
def poolCellZ (x : ℕ → ℕ → ℤ) (ho wo : ℕ) : ℤ :=
  maxZ (maxZ (x (2 * ho) (2 * wo)) (x (2 * ho + 1) (2 * wo)))
    (maxZ (x (2 * ho) (2 * wo + 1)) (x (2 * ho + 1) (2 * wo + 1)))

/-- The pooled `relu` of a `c×2h×2w` table is the flat list `pZ` (row-major, `c·h·w` long). -/
def poolTabZ (c h w : ℕ) (cZ : ℕ → ℕ → ℕ → ℤ) (pZ : List ℤ) : Bool :=
  allN c fun ci => allN h fun ho => allN w fun wo =>
    decide (poolCellZ (reluZ cZ ci) ho wo = pZ.getD (wo + w * (ho + h * ci)) 0)

/-- **The pooled feature vector of a conv table**, as the flat `getD` list a dense layer's
    `sum_getD_div` reads. -/
theorem maxPoolFlat_relu_tab {c h w : ℕ} {cZ : ℕ → ℕ → ℕ → ℤ} {pZ : List ℤ} {D : ℝ}
    (hD : 0 < D) (hchk : poolTabZ c h w cZ pZ = true) :
    maxPoolFlat c h w (relu (c * (2 * h) * (2 * w))
      (Tensor3.flatten (tabR cZ D : Tensor3 c (2 * h) (2 * w)))) =
        fun i : Fin (c * h * w) => (pZ.getD i 0 : ℝ) / D := by
  funext i
  obtain ⟨ci, ho, wo, rfl⟩ := t3Idx_surj i
  have hz := of_decide_eq_true
    (allN_spec (allN_spec (allN_spec hchk ci ci.2) ho ho.2) wo wo.2)
  have hidx : ((t3Idx ci ho wo : Fin (c * h * w)) : ℕ) = wo + w * (ho + h * ci) := by
    simp [t3Idx, finProdFinEquiv]
  rw [relu_flatten_tabR cZ hD]
  show Tensor3.flatten (maxPool2 (Tensor3.unflatten (Tensor3.flatten _))) _ = _
  rw [Tensor3.unflatten_flatten, flatten_t3Idx, hidx, ← hz]
  show max (max ((reluZ cZ ci (2 * ho) (2 * wo) : ℝ) / D)
      ((reluZ cZ ci (2 * ho + 1) (2 * wo) : ℝ) / D))
    (max ((reluZ cZ ci (2 * ho) (2 * wo + 1) : ℝ) / D)
      ((reluZ cZ ci (2 * ho + 1) (2 * wo + 1) : ℝ) / D)) = _
  rw [max_div_div_right hD.le, max_div_div_right hD.le, max_div_div_right hD.le, poolCellZ,
    maxZ_eq, maxZ_eq, maxZ_eq]
  push_cast
  rfl

-- ════════════════════════════════════════════════════════════════
-- § Twins from blank regions
-- ════════════════════════════════════════════════════════════════

/-- The zero-padded `kH×kW` patch at cell `(hi, wi)` is zero in every channel. -/
def zeroPatchZ (ic kH kW h w : ℕ) (x : ℕ → ℕ → ℕ → ℤ) (hi wi : ℕ) : Bool :=
  allN ic fun c => allN kH fun kh => allN kW fun kw =>
    decide (padZ kH kW h w (x c) kh kw hi wi = 0)

/-- Cells `(r, s)` and `(r', s')` both have all-zero patches. -/
def zeroTwinZ (ic kH kW h w : ℕ) (x : ℕ → ℕ → ℕ → ℤ) (r s r' s' : ℕ) : Bool :=
  zeroPatchZ ic kH kW h w x r s && zeroPatchZ ic kH kW h w x r' s'

/-- Two cells with all-zero patches are twins of the conv reading the table. -/
theorem convPatchEq_of_zeroPatchZ {ic h w kH kW : ℕ} {xZ : ℕ → ℕ → ℕ → ℤ} {d : ℝ}
    {p q : Fin h × Fin w} (hp : zeroPatchZ ic kH kW h w xZ p.1 p.2 = true)
    (hq : zeroPatchZ ic kH kW h w xZ q.1 q.2 = true) :
    ConvPatchEq kH kW (tabR xZ d : Tensor3 ic h w) p q := by
  refine ConvPatchEq.of_zero (fun cc kh kw => ?_) (fun cc kh kw => ?_)
  · rw [convPad_tabR, of_decide_eq_true
      (allN_spec (allN_spec (allN_spec hp cc cc.2) kh kh.2) kw kw.2), Int.cast_zero, zero_div]
  · rw [convPad_tabR, of_decide_eq_true
      (allN_spec (allN_spec (allN_spec hq cc cc.2) kh kh.2) kw kw.2), Int.cast_zero, zero_div]

theorem convPatchEq_of_zeroTwinZ {ic h w kH kW : ℕ} {xZ : ℕ → ℕ → ℕ → ℤ} {d : ℝ}
    (p q : Fin h × Fin w) (hpq : zeroTwinZ ic kH kW h w xZ p.1 p.2 q.1 q.2 = true) :
    ConvPatchEq kH kW (tabR xZ d : Tensor3 ic h w) p q := by
  rw [zeroTwinZ, Bool.and_eq_true] at hpq
  exact convPatchEq_of_zeroPatchZ hpq.1 hpq.2

/-- The outer read of cell `(hi, wi)` at kernel offset `(kh, kw)` is in bounds. -/
def inPadZ (kH kW h w kh kw hi wi : ℕ) : Bool :=
  decide ((kH - 1) / 2 ≤ kh + hi ∧ kh + hi - (kH - 1) / 2 < h ∧
    (kW - 1) / 2 ≤ kw + wi ∧ kw + wi - (kW - 1) / 2 < w)

/-- Cells `(r, s)` and `(r', s')` have blank two-conv receptive fields of the same shape: at
    every outer offset both reads fall in the padding, or both land on cells whose inner patches
    are all zero. Interior cells of a blank region are such pairs, and so are two cells on the
    same edge of the image. -/
def blankTwinZ (ic kH kW h w : ℕ) (x : ℕ → ℕ → ℕ → ℤ) (r s r' s' : ℕ) : Bool :=
  allN kH fun kh => allN kW fun kw =>
    (inPadZ kH kW h w kh kw r s == inPadZ kH kW h w kh kw r' s') &&
    (!inPadZ kH kW h w kh kw r s ||
      zeroTwinZ ic kH kW h w x (kh + r - (kH - 1) / 2) (kw + s - (kW - 1) / 2)
        (kh + r' - (kH - 1) / 2) (kw + s' - (kW - 1) / 2))

/-- Two cells with blank two-conv receptive fields of the same shape are two-layer twins. -/
theorem convPatchEq2_of_blankTwinZ {ic h w kH kW : ℕ} {xZ : ℕ → ℕ → ℕ → ℤ} {d : ℝ}
    (p q : Fin h × Fin w) (hpq : blankTwinZ ic kH kW h w xZ p.1 p.2 q.1 q.2 = true) :
    ConvPatchEq2 kH kW (tabR xZ d : Tensor3 ic h w) p q := by
  intro kh kw
  have h := allN_spec (allN_spec hpq kh kh.2) kw kw.2
  simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, Bool.not_eq_true'] at h
  obtain ⟨hiff, hz⟩ := h
  have hP : ∀ {hi wi : ℕ}, ((kH - 1) / 2 ≤ kh.val + hi ∧ kh.val + hi - (kH - 1) / 2 < h ∧
      (kW - 1) / 2 ≤ kw.val + wi ∧ kw.val + wi - (kW - 1) / 2 < w) ↔
      inPadZ kH kW h w kh kw hi wi = true := fun {hi wi} => by rw [inPadZ, decide_eq_true_eq]
  refine ⟨by rw [hP, hP, hiff], fun hp _ => ?_⟩
  rcases hz with hz | hz
  · rw [hP.mp hp] at hz
    exact absurd hz (by simp)
  · exact convPatchEq_of_zeroTwinZ _ _ hz

-- ════════════════════════════════════════════════════════════════
-- § The pool margin up to twins, one certificate per window
-- ════════════════════════════════════════════════════════════════

/-- The certificate of window `(ho, wo)` of one channel `x`: every cell is `≤ 0`, or some cell
    `m` has every cell at `m`'s position, more than `n` below it, or paired with `m` by `tw`. -/
def winCertZ (tw : ℕ → ℕ → ℕ → ℕ → Bool) (x : ℕ → ℕ → ℤ) (n : ℤ) (ho wo : ℕ) : Bool :=
  (allN 2 fun a => allN 2 fun b => decide (x (2 * ho + a) (2 * wo + b) ≤ 0)) ||
  anyN 2 fun ma => anyN 2 fun mb => allN 2 fun a => allN 2 fun b =>
    (ma == a && mb == b) ||
    decide (x (2 * ho + a) (2 * wo + b) + n < x (2 * ho + ma) (2 * wo + mb)) ||
    tw (2 * ho + ma) (2 * wo + mb) (2 * ho + a) (2 * wo + b)

/-- Every window of a `c×2h×2w` table carries a certificate. -/
def poolCertZ (c h w : ℕ) (tw : ℕ → ℕ → ℕ → ℕ → Bool) (cZ : ℕ → ℕ → ℕ → ℤ) (n : ℤ) : Bool :=
  allN c fun ci => allN h fun ho => allN w fun wo => winCertZ tw (cZ ci) n ho wo

/-- **The pool margin up to twins of a conv table**, from one kernel evaluation of `poolCertZ`.
    `tw` pairs only twins of `T` (`htw`); the margin `δ` is at most `n/(2D)`.
    `windowMarginUpTo_of_cert` with the certificates read off the `Bool`. -/
theorem maxPool2MarginQUpTo_of_poolCertZ {c h w : ℕ} {δ D : ℝ} (hδ : 0 ≤ δ) (hD : 0 < D)
    (T : Fin (2 * h) × Fin (2 * w) → Fin (2 * h) × Fin (2 * w) → Prop)
    (hsymm : ∀ p q, T p q → T q p) (htrans : ∀ p q u, T p q → T q u → T p u)
    (tw : ℕ → ℕ → ℕ → ℕ → Bool)
    (htw : ∀ p q : Fin (2 * h) × Fin (2 * w), tw p.1 p.2 q.1 q.2 = true → T p q)
    {cZ : ℕ → ℕ → ℕ → ℤ} {n : ℤ} (hn : 2 * δ ≤ (n : ℝ) / D)
    (hchk : poolCertZ c h w tw cZ n = true) :
    MaxPool2MarginQUpTo δ T (tabR cZ D : Tensor3 c (2 * h) (2 * w)) := by
  refine windowMarginUpTo_of_cert winRowInv winColInv hδ T hsymm htrans ?_
  intro ci ho wo
  have hw := allN_spec (allN_spec (allN_spec hchk ci ci.2) ho ho.2) wo wo.2
  rw [winCertZ, Bool.or_eq_true] at hw
  rcases hw with hdead | hlive
  · left
    intro cd
    have hz := of_decide_eq_true (allN_spec (allN_spec hdead cd.1 cd.1.2) cd.2 cd.2.2)
    show (cZ ci (2 * ho + cd.1) (2 * wo + cd.2) : ℝ) / D ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by exact_mod_cast hz) hD.le
  · right
    obtain ⟨ma, hma, hrest⟩ := anyN_spec hlive
    obtain ⟨mb, hmb, hrest⟩ := anyN_spec hrest
    refine ⟨(⟨ma, hma⟩, ⟨mb, hmb⟩), fun cd => ?_⟩
    have hcd := allN_spec (allN_spec hrest cd.1 cd.1.2) cd.2 cd.2.2
    simp only [Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hcd
    rcases hcd with (⟨h1, h2⟩ | hgap) | t
    · left
      refine Prod.ext (Fin.ext ?_) (Fin.ext ?_)
      · show 2 * ho.val + ma = 2 * ho.val + cd.1.val
        rw [h1]
      · show 2 * wo.val + mb = 2 * wo.val + cd.2.val
        rw [h2]
    · right; right
      have hg : ((cZ ci (2 * ho + cd.1) (2 * wo + cd.2) : ℤ) : ℝ) + (n : ℝ) <
          (cZ ci (2 * ho + ma) (2 * wo + mb) : ℝ) := by exact_mod_cast hgap
      show (cZ ci (2 * ho + cd.1) (2 * wo + cd.2) : ℝ) / D + 2 * δ <
        (cZ ci (2 * ho + ma) (2 * wo + mb) : ℝ) / D
      calc (cZ ci (2 * ho + cd.1) (2 * wo + cd.2) : ℝ) / D + 2 * δ
          ≤ (cZ ci (2 * ho + cd.1) (2 * wo + cd.2) : ℝ) / D + (n : ℝ) / D := by linarith
        _ = ((cZ ci (2 * ho + cd.1) (2 * wo + cd.2) : ℝ) + (n : ℝ)) / D := (add_div _ _ _).symm
        _ < (cZ ci (2 * ho + ma) (2 * wo + mb) : ℝ) / D := div_lt_div_of_pos_right hg hD
    · right; left
      exact htw (winRowInv ho ⟨ma, hma⟩, winColInv wo ⟨mb, hmb⟩)
        (winRowInv ho cd.1, winColInv wo cd.2) t

end Proofs
