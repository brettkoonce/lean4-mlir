theorem r3_eq : relu 8 (dense W3 b3 p2f) = r3V := by
  funext k
  show (if dense W3 b3 p2f k > 0 then dense W3 b3 p2f k else 0) = r3V k
  rw [d3_eq]
  fin_cases k <;> (simp [d3V, r3V])

