theorem d4_eq : ∀ k, dense W4 b4 r3V k = d4V k := by
  intro k
  fin_cases k <;> (simp [dense, W4, b4, r3V, d4V, Fin.sum_univ_succ]; try norm_num)

theorem head_feat : maxPoolFlat 2 6 6 (relu (2 * (2*6) * (2*6))
