theorem w9Z_len : w9Z.length = 784 := by decide +kernel

/-- The ten weight columns by class. -/
def wZ : Fin 10 → List ℤ
  | 0 => w0Z
  | 1 => w1Z
  | 2 => w2Z
  | 3 => w3Z
  | 4 => w4Z
  | 5 => w5Z
  | 6 => w6Z
  | 7 => w7Z
  | 8 => w8Z
  | 9 => w9Z

/-- Trained linear weights (input×class, entries `k/128`); the generator prints their test accuracy. -/
noncomputable def Wd : Mat 784 10 := fun i j => ((wZ j).getD i 0 : ℝ) / 128

noncomputable def bd : Vec 10 := fun _ => 0

/-- MNIST test image #8 (digit 5), pixels `k/255`. -/
noncomputable def xd : Vec 784 := fun i => (xdZ.getD i 0 : ℝ) / 255

def lblD : Fin 10 := 5
def cD : Fin 10 := 6

theorem xdZ_range : ∀ z ∈ xdZ, 0 ≤ z ∧ z ≤ 255 := by decide +kernel

theorem xd_nonneg : ∀ i, 0 ≤ xd i := by
  intro i
  have h := getD_of_forall xdZ (fun z => 0 ≤ z ∧ z ≤ 255) (by norm_num) xdZ_range i
  have h0 : (0 : ℝ) ≤ (xdZ.getD i 0 : ℝ) := by exact_mod_cast h.1
  exact div_nonneg h0 (by norm_num)

theorem xd_le_one : ∀ i, |xd i| ≤ 1 := by
  intro i
  have h := getD_of_forall xdZ (fun z => 0 ≤ z ∧ z ≤ 255) (by norm_num) xdZ_range i
  have h1 : (xdZ.getD i 0 : ℝ) ≤ 255 := by exact_mod_cast h.2
  rw [abs_of_nonneg (xd_nonneg i)]
  show (xdZ.getD i 0 : ℝ) / 255 ≤ 1
  rw [div_le_one (by norm_num)]
  exact h1

theorem xdZ_sum : xdZ.sum = 30734 := by decide +kernel
theorem xdZ_sq : dotZ xdZ xdZ = 6800852 := by decide +kernel

/-- `Σᵢ xᵢ` exactly (all coordinates nonneg). -/
theorem xd_sum : (∑ i, xd i) = ((30734 : ℝ)/255) := by
  show (∑ i : Fin 784, (xdZ.getD i 0 : ℝ) / 255) = _
  rw [← Finset.sum_div, sum_getD 784 xdZ xdZ_len, xdZ_sum]
  norm_num

theorem xd_sq_sum : (∑ i, xd i ^ 2) = ((6800852 : ℝ)/65025) := by
  have h := sum_getD_div xdZ_len xdZ_len xdZ_sq 255 255
  show (∑ i : Fin 784, ((xdZ.getD i 0 : ℝ) / 255) ^ 2) = _
  simp only [pow_two]
  rw [h]
  norm_num

