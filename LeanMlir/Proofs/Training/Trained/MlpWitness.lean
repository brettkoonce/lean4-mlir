/-- The second-layer pre-activations at the image, exactly. -/
theorem preact1_eq (m : Fin 8) :
    dense W1V b8 (relu 8 (dense W0V b8 xtV)) m = hpre1Vals m := by
  fin_cases m
  exacts [preact1_0, preact1_1, preact1_2, preact1_3, preact1_4, preact1_5, preact1_6, preact1_7]

/-- **Smoothness at the second ReLU**: no second-layer unit sits on the kink at the image. -/
theorem preact1_ne : ∀ m, dense W1V b8 (relu 8 (dense W0V b8 xtV)) m ≠ 0 := by
  intro m
  rw [preact1_eq]
  fin_cases m <;> norm_num [hpre1Vals]

-- ── level 1: the chapter's conditional VJP, instantiated ──

/-- **Level 1: the trained-weight whole-net VJP witness** — the chapter's `mlpHasVJPAt` at
    the trained `784 → 8 → 8 → 10` weights and the real image, both ReLU smoothness
    hypotheses discharged (`preact_ne`, `preact1_ne`). -/
noncomputable def trainedMlpHasVJPAt : HasVJPAt fwd xtV :=
  mlpHasVJPAt W0V b8 W1V b8 W2V b10 xtV preact_ne preact1_ne

/-- The backward of `trainedMlpHasVJPAt` is the `pdiv`-contracted Jacobian of the trained
    forward at the image: `mlpHasVJPAt_correct`, instantiated. -/
theorem trainedMlpHasVJPAt_correct (dy : Vec 10) (i : Fin 784) :
    trainedMlpHasVJPAt.backward dy i = ∑ j : Fin 10, pdiv fwd xtV i j * dy j :=
  mlpHasVJPAt_correct W0V b8 W1V b8 W2V b10 xtV preact_ne preact1_ne dy i

/-- The backward, unfolded: `W₂`, the second ReLU's mask, `W₁`, the first ReLU's mask, `W₀`. -/
theorem backward_eq (dy : Vec 10) :
    trainedMlpHasVJPAt.backward dy =
      Mat.mulVec W0V (fun k => if dense W0V b8 xtV k > 0 then
        Mat.mulVec W1V (fun m => if dense W1V b8 (relu 8 (dense W0V b8 xtV)) m > 0 then
          Mat.mulVec W2V dy m else 0) k else 0) := rfl

/-- The whole-net Jacobian in closed form at the image, read off the proven backward at a
    basis cotangent: `Σ_k W₀[i,k]·mask⁰_k·Σ_m W₁[k,m]·mask¹_m·W₂[m,c]`. -/
theorem pdiv_fwd (i : Fin 784) (c : Fin 10) :
    pdiv fwd xtV i c =
      ∑ k, W0V i k * ((if hpre0Vals k > 0 then (1:ℝ) else 0) *
        ∑ m, W1V k m * ((if hpre1Vals m > 0 then (1:ℝ) else 0) * W2V m c)) := by
  have h := trainedMlpHasVJPAt_correct (basisVec c) i
  rw [backward_eq] at h
  simp only [basisVec_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, ite_true, Mat.mulVec, preact_eq, preact1_eq] at h
  rw [← h]
  refine Finset.sum_congr rfl fun k _ => ?_
  split_ifs
  · rw [one_mul]
    congr 1
    refine Finset.sum_congr rfl fun m _ => ?_
    split_ifs <;> simp
  · simp

-- ── level 3: one Jacobian entry, ∂ logit_7 / ∂ x_621, exactly ──

theorem w0c0Z_at : w0c0Z.getD 621 0 = Int.negSucc 0 := by decide +kernel
theorem w0c1Z_at : w0c1Z.getD 621 0 = 1 := by decide +kernel
theorem w0c2Z_at : w0c2Z.getD 621 0 = Int.negSucc 6 := by decide +kernel
theorem w0c3Z_at : w0c3Z.getD 621 0 = Int.negSucc 36 := by decide +kernel
theorem w0c4Z_at : w0c4Z.getD 621 0 = Int.negSucc 11 := by decide +kernel
theorem w0c5Z_at : w0c5Z.getD 621 0 = 32 := by decide +kernel
theorem w0c6Z_at : w0c6Z.getD 621 0 = 17 := by decide +kernel
theorem w0c7Z_at : w0c7Z.getD 621 0 = Int.negSucc 11 := by decide +kernel

/-- Row 621 of `W0V`: pixel 621's eight outgoing weights. -/
theorem W0V_row (k : Fin 8) : W0V 621 k = (![((-1 : ℝ)/128), ((1 : ℝ)/128), ((-7 : ℝ)/128), ((-37 : ℝ)/128), ((-3 : ℝ)/32), ((1 : ℝ)/4), ((17 : ℝ)/128), ((-3 : ℝ)/32)] : Vec 8) k := by
  fin_cases k
  · show ((w0c0Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c0Z_at]
    norm_num
  · show ((w0c1Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c1Z_at]
    norm_num
  · show ((w0c2Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c2Z_at]
    norm_num
  · show ((w0c3Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c3Z_at]
    norm_num
  · show ((w0c4Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c4Z_at]
    norm_num
  · show ((w0c5Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c5Z_at]
    norm_num
  · show ((w0c6Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c6Z_at]
    norm_num
  · show ((w0c7Z.getD 621 0 : ℤ) : ℝ) / 128 = _
    rw [w0c7Z_at]
    norm_num

/-- The Jacobian entry `(∂ logit_7 / ∂ x_621)` at the image, exactly. -/
theorem pdiv_fwd_val : pdiv fwd xtV 621 7 = ((-1061555 : ℝ)/1048576) := by
  rw [pdiv_fwd]
  simp only [W0V_row]
  simp [W1V, W2V, w1Z, w2Z, w1c0Z, w1c1Z, w1c2Z, w1c3Z, w1c4Z, w1c5Z, w1c6Z, w1c7Z, w2c7Z,
    hpre0Vals, hpre1Vals, Fin.sum_univ_succ]
  norm_num

theorem pdiv_fwd_ne : pdiv fwd xtV 621 7 ≠ 0 := by
  rw [pdiv_fwd_val]
  norm_num

/-- **Level 3: the trained-weight backward is not the zero map.** -/
theorem trainedMlp_backward_nontrivial :
    trainedMlpHasVJPAt.backward (basisVec 7) 621 ≠ 0 :=
  trainedMlpHasVJPAt.backward_ne_zero_of_pdiv_ne pdiv_fwd_ne

/-- The `fderiv` form: the whole-net Jacobian at the image is nonzero. -/
theorem trainedMlp_jacobian_nonzero : fderiv ℝ fwd xtV ≠ 0 := by
  intro h
  apply pdiv_fwd_ne
  unfold pdiv
  rw [h]
  rfl

/-- The trained network is not a constant function. -/
theorem trainedMlp_not_constant : ¬ (∀ u v : Vec 784, fwd u = fwd v) := by
  intro h
  apply trainedMlp_jacobian_nonzero
  have hc : fwd = fun _ => fwd xtV := funext fun u => h u xtV
  rw [hc]
  exact (hasFDerivAt_const (fwd xtV) xtV).fderiv

end TrainedMlp
