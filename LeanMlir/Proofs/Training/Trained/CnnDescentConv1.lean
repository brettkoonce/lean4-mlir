/-- dense3 pre-activations at the image, exact. -/
noncomputable def d3V : Fin 8 → ℝ := ![((-154352684393 : ℝ)/68451041280), ((-17826367179 : ℝ)/22817013760), ((33160518331 : ℝ)/68451041280), ((-332665052927 : ℝ)/68451041280), ((-430836571847 : ℝ)/68451041280), ((625116588899 : ℝ)/68451041280), ((-35491180837 : ℝ)/4278190080), ((-506674525481 : ℝ)/68451041280)]

theorem d3_eq : ∀ k, dense W3 b3 p2f k = d3V k := by
