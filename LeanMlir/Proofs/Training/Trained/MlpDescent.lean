/-- **Descent at TRAINED weights, through both ReLU layers.** One SGD step with the exact
    gradient (lr = 2⁻35) on the input weights of the trained `784 → 8 → 8 → 10` MLP, at the
    misclassified test image, decreases the cross-entropy loss by at least `lr·‖∇L‖₂²/2`:
    every hypothesis of `mlp_input_sgd_descends` discharged at `η = 0`. -/
theorem trained_mlp_input_sgd_descends_concrete :
    (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V -
        (1 / 2 ^ 35 : ℝ) • gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V)) ≤
      (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) -
        (1 / 2 ^ 35 : ℝ) * (∑ idx, gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx ^ 2) / 2 := by
  have hR := radius_le
  have hR0 := radius_nonneg
  have hS2 := gradSq_lower
  refine mlp_input_sgd_descends W0V b8 W1V b8 W2V b10 xd lblD _ (lr := (1 / 2 ^ 35 : ℝ)) (η := 0)
    (a := 1) (w₁ := ((57 : ℝ)/32)) (w₂ := ((35 : ℝ)/16)) (by norm_num) xd_le_one (by norm_num) hW1V
    (by norm_num) hW2V (by norm_num) le_rfl (fun idx => by simp) ?_ ?_ ?_ ?_ ?_
  · -- hmargin0: the step cannot flip a first-layer ReLU
    intro j
    refine lt_of_le_of_lt (b := ((11617917403 : ℝ)/143552238122434560)) (by linarith) ?_
    rw [pre0_eq]
    fin_cases j <;> (rw [lt_abs]; norm_num [hpre0d])
  · -- hmargin1: nor a second-layer one
    intro l
    refine lt_of_le_of_lt (b := ((220740430657 : ℝ)/1531223873305968640)) (by linarith) ?_
    rw [pre1_eq]
    fin_cases l <;> (rw [lt_abs]; norm_num [hpre1d])
  · -- hsmall
    push_cast
    linarith
  · -- h1: the oracle is exact
    have hS20 : (0:ℝ) ≤ ∑ idx, gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    rw [mul_zero, zero_mul]
    positivity
  · -- h2: the segment-Lipschitz term against the guaranteed drop
    set rad := stepRadius (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) (1 / 2 ^ 35 : ℝ) 0 with hrad
    set S2 := ∑ idx, gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx ^ 2 with hS2def
    push_cast
    have hT : (0:ℝ) < 1 - 2 * (((35 : ℝ)/16) * (8 * (((57 : ℝ)/32) * (1 * rad)))) := by linarith
    rw [div_mul_eq_mul_div, div_le_iff₀ hT]
    have hsq : rad ^ 2 ≤ ((11617917403 : ℝ)/143552238122434560) ^ 2 := pow_le_pow_left₀ hR0 hR 2
    have hprod : (1 / 2 ^ 35 : ℝ) * ((4372714954060229 : ℝ)/69820062105600) / 4 * (1 - 2 * (((35 : ℝ)/16) * (8 * (((57 : ℝ)/32) * (1 * ((11617917403 : ℝ)/143552238122434560))))))
        ≤ (1 / 2 ^ 35 : ℝ) * S2 / 4 * (1 - 2 * (((35 : ℝ)/16) * (8 * (((57 : ℝ)/32) * (1 * rad))))) :=
      mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
    nlinarith [hsq, hprod]

/-- **The drop is strictly positive**: the image is misclassified and one hidden unit's
    backward coefficient is sign-definite, so `Σ∇² > 0` and the loss strictly decreases. -/
theorem trained_mlp_input_sgd_strictly_descends :
    (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V -
        (1 / 2 ^ 35 : ℝ) • gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V)) <
      (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) := by
  have h := trained_mlp_input_sgd_descends_concrete
  have h2 := gradSq_lower
  linarith [h, h2]

end TrainedMlpDescent
end Proofs
