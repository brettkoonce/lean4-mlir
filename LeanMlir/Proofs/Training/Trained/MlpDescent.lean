  exact div_nonneg h0 (by norm_num)

theorem xd_le_one : ∀ i, |xd i| ≤ 1 := by
  intro i
  have h := getD_of_forall xdZ (fun z => 0 ≤ z ∧ z ≤ 255) (by norm_num)
    xdZ_range i
  have h1 : (xdZ.getD i 0 : ℝ) ≤ 255 := by exact_mod_cast h.2
  rw [abs_of_nonneg (xd_nonneg i)]
  show (xdZ.getD i 0 : ℝ) / 255 ≤ 1
  rw [div_le_one (by norm_num)]
  exact h1

