-- ── softmax facts at the trained logits (no `exp` is ever evaluated) ──

theorem sm_pos : ∀ j, 0 < softmax 10 zd j := fun j =>
  div_pos (Real.exp_pos _)
    (Finset.sum_pos (fun _ _ => Real.exp_pos _) ⟨j, Finset.mem_univ j⟩)

theorem sm_sum : (∑ j, softmax 10 zd j) = 1 := by
  show (∑ j, Real.exp (zd j) / ∑ k, Real.exp (zd k)) = 1
  simp only [div_eq_mul_inv, ← Finset.sum_mul]
  exact mul_inv_cancel₀ (ne_of_gt (Finset.sum_pos
    (fun k _ => Real.exp_pos _) ⟨lblD, Finset.mem_univ _⟩))

/-- The ten softmax entries sum to one, written out. -/
theorem sm_sum_ten : softmax 10 zd 0 + softmax 10 zd 1 + softmax 10 zd 2 + softmax 10 zd 3 + softmax 10 zd 4 + softmax 10 zd 5 + softmax 10 zd 6 + softmax 10 zd 7 + softmax 10 zd 8 + softmax 10 zd 9 = 1 := by
  have h := sm_sum
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at h
  rw [← h]
  simp only [add_assoc]
  rfl

/-- **Softmax at the true label ≤ 1/2**, from misclassification alone:
    `exp z_lbl ≤ exp z_c` and both terms sit inside the positive sum. -/
theorem sm_lbl_le_half : softmax 10 zd lblD ≤ 1 / 2 := by
  have hee : Real.exp (zd lblD) ≤ Real.exp (zd cD) := Real.exp_le_exp.mpr hz_lbl_le
  have hSpos : 0 < ∑ k, Real.exp (zd k) :=
    Finset.sum_pos (fun k _ => Real.exp_pos _) ⟨lblD, Finset.mem_univ _⟩
  have hpair : Real.exp (zd lblD) + Real.exp (zd cD) ≤ ∑ k, Real.exp (zd k) := by
    have hsub := Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.subset_univ ({lblD, cD} : Finset (Fin 10)))
      (fun k _ _ => (Real.exp_pos (zd k)).le)
    rwa [Finset.sum_pair (by decide : lblD ≠ cD)] at hsub
  show Real.exp (zd lblD) / (∑ k, Real.exp (zd k)) ≤ 1 / 2
  rw [div_le_iff₀ hSpos]
  nlinarith [Real.exp_pos (zd lblD)]

-- ── the gradient: an outer product `xᵢ·c_k`, `c` a rational image of the cotangent ──

/-- The loss cotangent at the logits, `softmax − onehot`. -/
noncomputable def qd : Vec 10 := fun j => softmax 10 zd j - oneHot 10 lblD j

/-- The backward through both frozen masks: `mask⁰ ⊙ W₁(mask¹ ⊙ W₂ q)`. -/
noncomputable def backC (q : Vec 10) : Vec 8 := fun k =>
  (if hpre0d k > 0 then (1:ℝ) else 0) *
    ∑ l, W1V k l * ((if hpre1d l > 0 then (1:ℝ) else 0) * ∑ j, W2V l j * q j)

/-- `∂L/∂W₀[i,k] = xᵢ·c_k` at the trained weights: `mlp_input_loss_gradAt`, the two masks
    read off the exact pre-activations. -/
theorem grad_key (i : Fin 784) (k : Fin 8) :
    gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) (finProdFinEquiv (i, k)) =
      xd i * backC qd k := by
  unfold mlpInputLoss
  rw [mlp_input_loss_gradAt b8 W1V b8 W2V b10 xd lblD (Mat.flatten W0V)
    (by rw [Mat.unflatten_flatten]; exact pre0_ne)
    (by rw [Mat.unflatten_flatten]; exact pre1_ne) i k]
  simp only [Mat.unflatten_flatten, pre0_eq, pre1_eq]
  rfl

