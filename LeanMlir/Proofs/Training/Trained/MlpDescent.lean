  rw [backC_4]
  simp only [qd_0, qd_1, qd_2, qd_3, qd_4, qd_5, qd_6, qd_7, qd_8, qd_9]
  have hhalf : softmax 10 zd 3 ≤ 1 / 2 := sm_lbl_le_half
  linarith [sm_sum_ten, sm_pos 0, sm_pos 1, sm_pos 2, sm_pos 3, sm_pos 4, sm_pos 5, sm_pos 6, sm_pos 7, sm_pos 8, sm_pos 9]

theorem cot_sq_lower : ((938135641 : ℝ)/1073741824) ≤ ∑ k, backC qd k ^ 2 := by
  have hterm : ((938135641 : ℝ)/1073741824) ≤ backC qd 4 ^ 2 := by
    nlinarith [cot_lower]
  exact hterm.trans (Finset.single_le_sum (f := fun k => backC qd k ^ 2)
    (fun k _ => sq_nonneg _) (Finset.mem_univ (4 : Fin 8)))

-- ── the gradient sums, bracketed by exact rationals ──

/-- `Σ|∇L| ≤ (Σxᵢ)·ΣU_k`, exact. -/
theorem gradL1_le :
    (∑ idx, |gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx|) ≤ ((11617917403 : ℝ)/4177920) := by
  rw [← finProdFinEquiv.sum_comp (fun idx => |gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx|)]
  rw [Fintype.sum_prod_type]
  simp_rw [grad_key]
  calc (∑ i : Fin 784, ∑ k : Fin 8, |xd i * backC qd k|)
      = ∑ i : Fin 784, xd i * ∑ k : Fin 8, |backC qd k| := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [abs_mul, abs_of_nonneg (xd_nonneg i)]
    _ ≤ ∑ i : Fin 784, xd i * ∑ k : Fin 8, cotUb k :=
        Finset.sum_le_sum fun i _ =>
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun k _ => cot_abs_le k) (xd_nonneg i)
    _ = (∑ i, xd i) * ∑ k : Fin 8, cotUb k := by
        rw [Finset.sum_mul]
    _ = ((11617917403 : ℝ)/4177920) := by
        rw [xd_sum]
        simp only [cotUb, Fin.sum_univ_succ, Fin.sum_univ_zero]
        norm_num

/-- `Σ(∇L)² ≥ (Σxᵢ²)·(30629/16384)²/4`, exact. -/
theorem gradSq_lower :
    ((4372714954060229 : ℝ)/69820062105600) ≤ ∑ idx, gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx ^ 2 := by
  rw [← finProdFinEquiv.sum_comp (fun idx => gradAt (mlpInputLoss b8 W1V b8 W2V b10 xd lblD) (Mat.flatten W0V) idx ^ 2)]
  rw [Fintype.sum_prod_type]
  simp_rw [grad_key]
  have hfac : (∑ i : Fin 784, ∑ k : Fin 8, (xd i * backC qd k) ^ 2) =
      (∑ i, xd i ^ 2) * ∑ k : Fin 8, backC qd k ^ 2 := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hfac, xd_sq_sum]
  calc ((4372714954060229 : ℝ)/69820062105600) = ((4661069 : ℝ)/65025) * ((938135641 : ℝ)/1073741824) := by norm_num
    _ ≤ ((4661069 : ℝ)/65025) * ∑ k : Fin 8, backC qd k ^ 2 :=
        mul_le_mul_of_nonneg_left cot_sq_lower (by norm_num)

