theorem hW1V : ∀ k m, |W1V k m| ≤ ((57 : ℝ)/32) := by
  intro k m
  have key : ∀ xs : List ℤ, (∀ z ∈ xs, Int.negSucc 227 ≤ z ∧ z ≤ 228) →
      |(xs.getD k 0 : ℝ) / 128| ≤ ((57 : ℝ)/32) := by
    intro xs hxs
    have h := getD_of_forall xs (fun z => Int.negSucc 227 ≤ z ∧ z ≤ 228)
      (by decide) hxs k
    have h1 : ((Int.negSucc 227 : ℤ) : ℝ) ≤ (xs.getD k 0 : ℝ) := by exact_mod_cast h.1
    have h2 : (xs.getD k 0 : ℝ) ≤ 228 := by exact_mod_cast h.2
    rw [abs_le]
    constructor
    · rw [le_div_iff₀ (by norm_num)]
      push_cast at h1
      linarith
    · rw [div_le_iff₀ (by norm_num)]
      linarith
  fin_cases m
  · exact key w1c0Z (by decide +kernel)
  · exact key w1c1Z (by decide +kernel)
  · exact key w1c2Z (by decide +kernel)
  · exact key w1c3Z (by decide +kernel)
  · exact key w1c4Z (by decide +kernel)
  · exact key w1c5Z (by decide +kernel)
  · exact key w1c6Z (by decide +kernel)
  · exact key w1c7Z (by decide +kernel)

