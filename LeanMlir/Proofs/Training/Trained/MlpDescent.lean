/-- `|c_k| ≤ U_k`: `c_k` is a convex combination of the differences `G_kj − G_k,lbl`. -/
theorem cot_abs_le (k : Fin 8) : |backC qd k| ≤ cotUb k := by
  fin_cases k
  exacts [cot_abs_le_0, cot_abs_le_1, cot_abs_le_2, cot_abs_le_3, cot_abs_le_4, cot_abs_le_5, cot_abs_le_6, cot_abs_le_7]

/-- Row 4 is sign-definite: `c_4 ≥ 30629/16384·(1 − p_lbl) ≥ 30629/32768`. -/
