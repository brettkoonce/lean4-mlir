/-- The layer-1 box, via the uniform collapse `conv2d Wc bc x ∓ ε·AC`. -/
theorem box1e4 :
    convLo Wc bc (fun a b d => img1 a b d - ((4:ℝ)/255))
      (fun a b d => img1 a b d + ((4:ℝ)/255)) = lo1e4 ∧
    convHi Wc bc (fun a b d => img1 a b d - ((4:ℝ)/255))
      (fun a b d => img1 a b d + ((4:ℝ)/255)) = hi1e4 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx1_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx1, AC, lo1e4]
        try norm_num
  · rw [convHi_uniform, cx1_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx1, AC, hi1e4]
        try norm_num

