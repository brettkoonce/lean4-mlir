/-- The box after ReLU and max-pool (both monotone: pool the endpoints). -/
theorem pool1e4 :
    maxPool2 (c := 4) (h := 4) (w := 4) (reluT lo1e4) = plo1e4 ∧ maxPool2 (c := 4) (h := 4) (w := 4) (reluT hi1e4) = phi1e4 := by
  constructor <;> funext o i j <;>
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [maxPool2, reluT, lo1e4, hi1e4, plo1e4, phi1e4]
        try norm_num

/-- **Certified at ε = 4/255** (MNIST test image #1, class 2): EVERY
    pixel-`L∞` perturbation of size ≤ 4/255 leaves class 2 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert1e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img1 2 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box1e4).1, (box1e4).2,
    (pool1e4).1, (pool1e4).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo1e4, phi1e4, Fin.sum_univ_succ]
        try norm_num

/-- Certified at ε = 1/255 (image #1) — the radius-4/255
    certificate restricted; no second box. -/
theorem cert1e1 : CertifiedAtLinf3 net ((1:ℝ)/255) img1 2 :=
  cert1e4.mono (by norm_num)

/-- Certified at ε = 2/255 (image #1) — the radius-4/255
    certificate restricted; no second box. -/
theorem cert1e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img1 2 :=
  cert1e4.mono (by norm_num)

