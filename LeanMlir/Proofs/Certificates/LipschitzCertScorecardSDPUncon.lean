-- § Aggregate — mechanized (peer of `scorecard`)
-- ════════════════════════════════════════════════════════════

/-- LipSDP-certified witnesses on the unconstrained net: `(subset index, image, class)`. -/
noncomputable def sdpUnconCerts : List (ℕ × EuclideanSpace ℝ (Fin 49) × Fin 10) :=
  [(0, img0, 7), (2, imgU2, 1), (3, img3, 0), (4, imgU4, 4), (5, img5, 1), (6, imgU6, 4), (10, img10, 0), (11, imgU11, 6)]

theorem sdpUnconCerts_certified :
    ∀ p ∈ sdpUnconCerts, CertifiedAt mlpT ((1 : ℝ)/10) p.2.1 p.2.2 :=
  List.forall_iff_forall_mem.mp
    ⟨certifiedSU0, certifiedSU2, certifiedSU3, certifiedSU4, certifiedSU5, certifiedSU6, certifiedSU10, certifiedSU11⟩

/-- **The LipSDP scorecard** — MEASURED 63/100, vs 1/100 under the
    global √2·∏-norm criterion, same net, same ε, same images; the constant
    was the bottleneck, not the network. The 8 below are the emitted
    witnesses carrying `CertifiedAt` proofs, not that measurement. -/
theorem scorecard_sdp_uncon :
    sdpUnconCerts.length = 8 ∧
      ∀ p ∈ sdpUnconCerts, CertifiedAt mlpT ((1 : ℝ)/10) p.2.1 p.2.2 :=
  ⟨rfl, sdpUnconCerts_certified⟩

