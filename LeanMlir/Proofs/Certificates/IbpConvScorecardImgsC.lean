    conv2d Wc bc img4 o i j = cx4 o i j := by
  intro o i j
  fin_cases o <;> fin_cases i <;> fin_cases j <;>
    · simp [conv2d, Wc, bc, img4, cx4, Fin.sum_univ_succ]
      try norm_num

