/-- The layer-1 box, via the uniform collapse `conv2d Wc bc x ∓ ε·AC`. -/
theorem box5e8 :
    convLo Wc bc (fun a b d => img5 a b d - ((8:ℝ)/255))
      (fun a b d => img5 a b d + ((8:ℝ)/255)) = lo5e8 ∧
    convHi Wc bc (fun a b d => img5 a b d - ((8:ℝ)/255))
      (fun a b d => img5 a b d + ((8:ℝ)/255)) = hi5e8 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx5_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx5, AC, lo5e8]
        try norm_num
  · rw [convHi_uniform, cx5_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx5, AC, hi5e8]
        try norm_num

