/-- The box after ReLU and max-pool (both monotone: pool the endpoints). -/
theorem pool5e8 :
    maxPool2 (c := 4) (h := 4) (w := 4) (reluT lo5e8) = plo5e8 ∧ maxPool2 (c := 4) (h := 4) (w := 4) (reluT hi5e8) = phi5e8 := by
  constructor <;> funext o i j <;>
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [maxPool2, reluT, lo5e8, hi5e8, plo5e8, phi5e8]
        try norm_num

/-- **Certified at ε = 8/255** (MNIST test image #5, class 1): EVERY
    pixel-`L∞` perturbation of size ≤ 8/255 leaves class 1 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert5e8 : CertifiedAtLinf3 net ((8:ℝ)/255) img5 1 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box5e8).1, (box5e8).2,
    (pool5e8).1, (pool5e8).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo5e8, phi5e8, Fin.sum_univ_succ]
        try norm_num

/-- Certified at ε = 1/255 (image #5) — the radius-8/255
    certificate restricted; no second box. -/
theorem cert5e1 : CertifiedAtLinf3 net ((1:ℝ)/255) img5 1 :=
  cert5e8.mono (by norm_num)

