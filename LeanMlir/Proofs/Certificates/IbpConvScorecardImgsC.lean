     ![(0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ)]]]

noncomputable def img4 : Tensor3 1 8 8 := castT img4Q

/-- **Certified at ε = 4/255** (MNIST test image #4, class 4): EVERY
    pixel-`L∞` perturbation of size ≤ 4/255 leaves class 4 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. One kernel
    evaluation of the exact box. -/
theorem cert4e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img4 4 := by
  simpa [img4] using net_certified_of_check img4Q ((4:ℚ)/255) 4 (by decide +kernel)

/-- Certified at ε = 1/255 (image #4) — the radius-4/255
    certificate restricted; no second box. -/
theorem cert4e1 : CertifiedAtLinf3 net ((1:ℝ)/255) img4 4 :=
  cert4e4.mono (by norm_num)

/-- Certified at ε = 2/255 (image #4) — the radius-4/255
    certificate restricted; no second box. -/
theorem cert4e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img4 4 :=
  cert4e4.mono (by norm_num)

