/-- MNIST test image #4, pooled to 8×8, exact. -/
def img4Q : Fin 1 → Fin 8 → Fin 8 → ℚ :=
  ![![![(0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ)],
     ![(0:ℚ), (0:ℚ), (0:ℚ), ((137:ℚ)/2040), (0:ℚ), ((33:ℚ)/1360), (0:ℚ), (0:ℚ)],
     ![(0:ℚ), (0:ℚ), ((59:ℚ)/680), ((1393:ℚ)/4080), (0:ℚ), ((99:ℚ)/272), (0:ℚ), (0:ℚ)],
