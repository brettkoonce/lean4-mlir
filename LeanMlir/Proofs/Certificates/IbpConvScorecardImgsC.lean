theorem box4e4 :
    convLo Wc bc (fun a b d => img4 a b d - ((4:ℝ)/255))
      (fun a b d => img4 a b d + ((4:ℝ)/255)) = lo4e4 ∧
    convHi Wc bc (fun a b d => img4 a b d - ((4:ℝ)/255))
      (fun a b d => img4 a b d + ((4:ℝ)/255)) = hi4e4 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx4_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx4, AC, lo4e4]
        try norm_num
  · rw [convHi_uniform, cx4_eval, AC_eval]
