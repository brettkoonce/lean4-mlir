/-- The layer-1 box, via the uniform collapse `conv2d Wc bc x ∓ ε·AC`. -/
theorem box3e4 :
    convLo Wc bc (fun a b d => img3 a b d - ((4:ℝ)/255))
      (fun a b d => img3 a b d + ((4:ℝ)/255)) = lo3e4 ∧
    convHi Wc bc (fun a b d => img3 a b d - ((4:ℝ)/255))
      (fun a b d => img3 a b d + ((4:ℝ)/255)) = hi3e4 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx3_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx3, AC, lo3e4]
        try norm_num
  · rw [convHi_uniform, cx3_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx3, AC, hi3e4]
        try norm_num

