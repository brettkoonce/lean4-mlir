/-- **Certified at ε = 4/255** (MNIST test image #4, class 4): EVERY
    pixel-`L∞` perturbation of size ≤ 4/255 leaves class 4 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert4e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img4 4 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box4e4).1, (box4e4).2,
    (pool4e4).1, (pool4e4).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo4e4, phi4e4, Fin.sum_univ_succ]
        try norm_num

