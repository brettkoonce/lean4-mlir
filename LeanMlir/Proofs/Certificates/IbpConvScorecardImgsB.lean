/-- The layer-1 box, via the uniform collapse `conv2d Wc bc x ∓ ε·AC`. -/
theorem box9e1 :
    convLo Wc bc (fun a b d => img9 a b d - ((1:ℝ)/255))
      (fun a b d => img9 a b d + ((1:ℝ)/255)) = lo9e1 ∧
    convHi Wc bc (fun a b d => img9 a b d - ((1:ℝ)/255))
      (fun a b d => img9 a b d + ((1:ℝ)/255)) = hi9e1 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx9_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx9, AC, lo9e1]
        try norm_num
  · rw [convHi_uniform, cx9_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx9, AC, hi9e1]
        try norm_num

