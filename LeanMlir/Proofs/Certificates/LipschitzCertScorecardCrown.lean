      (relaxC (loSFe8_0 t) (hiSFe8_0 t) (alSFe8_0 t) (slSFe8_0 t) v) := by
  intro t v
  refine reluLB_relax ?_ ?_ ?_ ?_ <;>
    fin_cases t <;> norm_num [alSFe8_0, slSFe8_0, loSFe8_0, hiSFe8_0]

