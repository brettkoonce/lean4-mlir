/-- **Certified at ε = 4/255** (MNIST test image #3, class 0): EVERY
    pixel-`L∞` perturbation of size ≤ 4/255 leaves class 0 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert3e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img3 0 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box3e4).1, (box3e4).2,
    (pool3e4).1, (pool3e4).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo3e4, phi3e4, Fin.sum_univ_succ]
        try norm_num

