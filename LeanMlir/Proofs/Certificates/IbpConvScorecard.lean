/-- **Certified at ε = 4/255** (MNIST test image #28, class 0): EVERY
    pixel-`L∞` perturbation of size ≤ 4/255 leaves class 0 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert28e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img28 0 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box28e4).1, (box28e4).2,
    (pool28e4).1, (pool28e4).2]
