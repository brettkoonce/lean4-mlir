    convHi Wc bc (fun a b d => img31 a b d - ((2:ℝ)/255))
      (fun a b d => img31 a b d + ((2:ℝ)/255)) = hi31e2 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx31_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx31, AC, lo31e2]
        try norm_num
