/-- **The convolutional IBP scorecard, as a theorem.** Each count is tied to
    its per-image `CertifiedAtLinf3` proofs, not just a list length. Lower bounds
    only: a loose box cannot prove an image UNcertifiable. -/
theorem scorecard_ibp_conv :
(certsE1.length = 35 ∧
      ∀ p ∈ certsE1, CertifiedAtLinf3 net ((1:ℝ)/255) p.2.1 p.2.2)
  ∧ (certsE2.length = 33 ∧
      ∀ p ∈ certsE2, CertifiedAtLinf3 net ((2:ℝ)/255) p.2.1 p.2.2)
  ∧ (certsE4.length = 23 ∧
      ∀ p ∈ certsE4, CertifiedAtLinf3 net ((4:ℝ)/255) p.2.1 p.2.2)
  ∧ (certsE8.length = 5 ∧
      ∀ p ∈ certsE8, CertifiedAtLinf3 net ((8:ℝ)/255) p.2.1 p.2.2) :=
  ⟨⟨rfl, certsE1_certified⟩, ⟨rfl, certsE2_certified⟩, ⟨rfl, certsE4_certified⟩, ⟨rfl, certsE8_certified⟩⟩

