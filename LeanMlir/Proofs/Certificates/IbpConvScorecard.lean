/-- **Certified at ε = 2/255** (MNIST test image #27, class 4): EVERY
    pixel-`L∞` perturbation of size ≤ 2/255 leaves class 4 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert27e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img27 4 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box27e2).1, (box27e2).2,
    (pool27e2).1, (pool27e2).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo27e2, phi27e2, Fin.sum_univ_succ]
        try norm_num

