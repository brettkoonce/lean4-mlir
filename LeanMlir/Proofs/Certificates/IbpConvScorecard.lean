/-- **Certified at ε = 8/255** (MNIST test image #0, class 7): EVERY
    pixel-`L∞` perturbation of size ≤ 8/255 leaves class 7 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert0e8 : CertifiedAtLinf3 net ((8:ℝ)/255) img0 7 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box0e8).1, (box0e8).2,
    (pool0e8).1, (pool0e8).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo0e8, phi0e8, Fin.sum_univ_succ]
        try norm_num

