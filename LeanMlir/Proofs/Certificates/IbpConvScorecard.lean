      (fun a b d => img10 a b d + ((8:ℝ)/255)) = hi10e8 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx10_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx10, AC, lo10e8]
        try norm_num
  · rw [convHi_uniform, cx10_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx10, AC, hi10e8]
