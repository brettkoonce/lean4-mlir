/-- The layer-1 box, via the uniform collapse `conv2d Wc bc x ∓ ε·AC`. -/
theorem box35e4 :
    convLo Wc bc (fun a b d => img35 a b d - ((4:ℝ)/255))
      (fun a b d => img35 a b d + ((4:ℝ)/255)) = lo35e4 ∧
    convHi Wc bc (fun a b d => img35 a b d - ((4:ℝ)/255))
      (fun a b d => img35 a b d + ((4:ℝ)/255)) = hi35e4 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx35_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx35, AC, lo35e4]
        try norm_num
  · rw [convHi_uniform, cx35_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx35, AC, hi35e4]
        try norm_num

