      (fun a b d => img32 a b d + ((2:ℝ)/255)) = hi32e2 := by
  constructor <;> funext o i j
  · rw [convLo_uniform, cx32_eval, AC_eval]
    fin_cases o <;> fin_cases i <;> fin_cases j <;>
      · simp [cx32, AC, lo32e2]
        try norm_num
