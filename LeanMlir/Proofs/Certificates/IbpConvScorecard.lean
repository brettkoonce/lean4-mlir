/-- **Certified at ε = 2/255** (MNIST test image #32, class 3): EVERY
    pixel-`L∞` perturbation of size ≤ 2/255 leaves class 3 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert32e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img32 3 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box32e2).1, (box32e2).2,
    (pool32e2).1, (pool32e2).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo32e2, phi32e2, Fin.sum_univ_succ]
        try norm_num

