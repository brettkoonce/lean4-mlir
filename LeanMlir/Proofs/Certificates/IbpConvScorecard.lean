/-- **Certified at ε = 2/255** (MNIST test image #31, class 1): EVERY
    pixel-`L∞` perturbation of size ≤ 2/255 leaves class 1 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert31e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img31 1 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box31e2).1, (box31e2).2,
    (pool31e2).1, (pool31e2).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo31e2, phi31e2, Fin.sum_univ_succ]
        try norm_num

/-- Certified at ε = 1/255 (image #31) — the radius-2/255
    certificate restricted; no second box. -/
theorem cert31e1 : CertifiedAtLinf3 net ((1:ℝ)/255) img31 1 :=
  cert31e2.mono (by norm_num)

