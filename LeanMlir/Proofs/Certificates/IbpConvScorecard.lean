/-- **Certified at ε = 4/255** (MNIST test image #13, class 0): EVERY
    pixel-`L∞` perturbation of size ≤ 4/255 leaves class 0 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert13e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img13 0 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box13e4).1, (box13e4).2,
    (pool13e4).1, (pool13e4).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo13e4, phi13e4, Fin.sum_univ_succ]
        try norm_num

