noncomputable def sdpUnconFullCerts10 : List (ℕ × EuclideanSpace ℝ (Fin 784) × Fin 10) :=
  [(0, imgF0, 7),
   (1, imgF1, 2),
   (2, imgF2, 1),
   (3, imgF3, 0),
   (4, imgF4, 4),
   (5, imgF5, 1),
