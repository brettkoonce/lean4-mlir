      mlp_gap_eq W1TF W2TF 8 9 w
    rw [h]
    exact Finset.sum_congr rfl fun t _ => by rw [vP89TF_eq t]
  rw [e u, e u']
  exact pair_sq_bound W1TF G1TF G1TF_eq vP89TF tP89TF tP89TF_nonneg (by norm_num)
    hS89TF u u'

