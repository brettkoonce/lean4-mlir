theorem sdpUnconFullCerts10_certified :
    ∀ p ∈ sdpUnconFullCerts10, CertifiedAt mlpTF ((1 : ℝ)/10) p.2.1 p.2.2 :=
  List.forall_iff_forall_mem.mp
    ⟨certifiedSTF10_0, certifiedSTF10_1, certifiedSTF10_2, certifiedSTF10_3, certifiedSTF10_4, certifiedSTF10_5, certifiedSTF10_6, certifiedSTF10_7⟩

