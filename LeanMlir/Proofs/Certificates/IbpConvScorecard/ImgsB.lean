     ![(0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ)]]]

noncomputable def img2 : Tensor3 1 8 8 := castT img2Q

/-- **Certified at ε = 8/255** (MNIST test image #2, class 1): EVERY
    pixel-`L∞` perturbation of size ≤ 8/255 leaves class 1 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. One kernel
    evaluation of the exact box. -/
theorem cert2e8 : CertifiedAtLinf3 net ((8:ℝ)/255) img2 1 := by
  simpa [img2] using net_certified_of_check img2Q ((8:ℚ)/255) 1 (by decide +kernel)

/-- Certified at ε = 1/255 (image #2) — the radius-8/255
    certificate restricted; no second box. -/
theorem cert2e1 : CertifiedAtLinf3 net ((1:ℝ)/255) img2 1 :=
  cert2e8.mono (by norm_num)

/-- Certified at ε = 2/255 (image #2) — the radius-8/255
    certificate restricted; no second box. -/
theorem cert2e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img2 1 :=
  cert2e8.mono (by norm_num)

/-- Certified at ε = 4/255 (image #2) — the radius-8/255
    certificate restricted; no second box. -/
theorem cert2e4 : CertifiedAtLinf3 net ((4:ℝ)/255) img2 1 :=
  cert2e8.mono (by norm_num)

