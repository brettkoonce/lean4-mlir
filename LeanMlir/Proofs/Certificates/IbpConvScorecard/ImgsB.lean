/-! # Conv IBP scorecard, image chunk B — test images #2, #3

Per-image `CertifiedAtLinf3` theorems for the conv net of
`IbpConvScorecard.Net`: each image's exact data and one kernel check of
its box at the largest certifying radius; smaller radii follow by `.mono`.
The aggregate lives in `IbpConvScorecard.Basic`. Generated by
`scripts/certs/ibp_conv_scorecard.py`. -/

namespace Proofs
namespace IBP
namespace ConvNet

-- ═══════════════ MNIST test image #2 (label 1) ═══════════════
/-- MNIST test image #2, pooled to 8×8, exact. -/
def img2Q : Fin 1 → Fin 8 → Fin 8 → ℚ :=
  ![![![(0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ)],
     ![(0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), ((631:ℚ)/4080), ((191:ℚ)/4080), (0:ℚ), (0:ℚ)],
     ![(0:ℚ), (0:ℚ), (0:ℚ), (0:ℚ), ((413:ℚ)/1020), (0:ℚ), (0:ℚ), (0:ℚ)],
     ![(0:ℚ), (0:ℚ), (0:ℚ), ((19:ℚ)/1360), ((1967:ℚ)/4080), (0:ℚ), (0:ℚ), (0:ℚ)],
     ![(0:ℚ), (0:ℚ), (0:ℚ), ((185:ℚ)/816), ((1129:ℚ)/4080), (0:ℚ), (0:ℚ), (0:ℚ)],
