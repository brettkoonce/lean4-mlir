  denseT Wd bd ∘ maxPool2 (c := 4) (h := 4) (w := 4) ∘ reluT ∘ conv2d Wc bc

/-- The propagated box, assembled by `BoxSound3.comp` — depth is composition. -/
noncomputable def netLo (lo hi : Tensor3 1 8 8) : Vec 10 :=
  denseTLo Wd bd (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convLo Wc bc lo hi)))
                 (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convHi Wc bc lo hi)))

noncomputable def netHi (lo hi : Tensor3 1 8 8) : Vec 10 :=
  denseTHi Wd bd (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convLo Wc bc lo hi)))
                 (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convHi Wc bc lo hi)))

theorem net_boxSound : BoxSound3V net netLo netHi :=
  (denseT_boxSound3V Wd bd).comp3
    ((maxPool2_boxSound3 (c := 4) (h := 4) (w := 4)).comp
      (reluT_boxSound3.comp (conv2d_boxSound3 Wc bc)))

