def bdQ : Fin 10 → ℚ := ![((-15:ℚ)/64), ((135:ℚ)/128), ((-13:ℚ)/128), ((-3:ℚ)/8), ((47:ℚ)/128), ((43:ℚ)/64), ((-69:ℚ)/128), ((139:ℚ)/256), ((-327:ℚ)/256), ((-7:ℚ)/64)]

/-- The conv kernel over `ℝ`: the cast of the exact data. -/
noncomputable def Wc : Kernel4 4 1 3 3 := castK WcQ

noncomputable def bc : Vec 4 := castV bcQ

noncomputable def Wd : Fin 4 → Fin 4 → Fin 4 → Fin 10 → ℝ := castW WdQ

noncomputable def bd : Vec 10 := castV bdQ

/-- The certified network: conv → relu → max-pool → dense head. Four layers,
    a genuine convolution and a genuine max-pool — the shapes `ibp2_certified_at_eps`
    could not reach. -/
noncomputable def net : Tensor3 1 8 8 → Vec 10 :=
  denseT Wd bd ∘ maxPool2 (c := 4) (h := 4) (w := 4) ∘ reluT ∘ conv2d Wc bc

/-- The propagated box, assembled by `BoxSound3.comp` — depth is composition. -/
noncomputable def netLo (lo hi : Tensor3 1 8 8) : Vec 10 :=
  denseTLo Wd bd (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convLo Wc bc lo hi)))
                 (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convHi Wc bc lo hi)))

noncomputable def netHi (lo hi : Tensor3 1 8 8) : Vec 10 :=
  denseTHi Wd bd (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convLo Wc bc lo hi)))
                 (maxPool2 (c := 4) (h := 4) (w := 4) (reluT (convHi Wc bc lo hi)))

theorem net_boxSound : BoxSound3V net netLo netHi :=
  (denseT_boxSound3V Wd bd).comp3
    ((maxPool2_boxSound3 (c := 4) (h := 4) (w := 4)).comp
      (reluT_boxSound3.comp (conv2d_boxSound3 Wc bc)))

/-- **One image, one kernel check.** `convNetCheckQ` propagates the pixel box
    through the exact-`ℚ` net; `true` is a certificate for `net` on the cast image. -/
theorem net_certified_of_check (x : Fin 1 → Fin 8 → Fin 8 → ℚ) (ε : ℚ) (y : Fin 10)
    (hc : convNetCheckQ WcQ bcQ WdQ bdQ x ε y = true) :
    CertifiedAtLinf3 net (ε : ℝ) (castT x) y :=
  convNetCheckQ_sound WcQ bcQ WdQ bdQ x ε y hc

