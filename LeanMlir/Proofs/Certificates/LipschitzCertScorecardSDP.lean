/-- LipSDP-certified witnesses on the capped net: `(subset index, image, class)`. -/
noncomputable def sdpCappedCerts : List (ℕ × EuclideanSpace ℝ (Fin 49) × Fin 10) :=
  [(0, img0, 7), (2, img2, 1), (3, img3, 0), (4, img4, 4), (5, img5, 1), (6, img6, 4), (7, img7, 9), (9, img9, 9)]

theorem sdpCappedCerts_certified :
    ∀ p ∈ sdpCappedCerts, CertifiedAt mlpS ((1 : ℝ)/10) p.2.1 p.2.2 :=
  List.forall_iff_forall_mem.mp
    ⟨certifiedSC0, certifiedSC2, certifiedSC3, certifiedSC4, certifiedSC5, certifiedSC6, certifiedSC7, certifiedSC9⟩

/-- **The LipSDP scorecard** — MEASURED 69/100, vs 34/100 under the
    global √2·∏-norm criterion, same net, same ε, same images; the constant
    was the bottleneck, not the network. The 8 below are the emitted
    witnesses carrying `CertifiedAt` proofs, not that measurement. -/
theorem scorecard_sdp :
    sdpCappedCerts.length = 8 ∧
      ∀ p ∈ sdpCappedCerts, CertifiedAt mlpS ((1 : ℝ)/10) p.2.1 p.2.2 :=
  ⟨rfl, sdpCappedCerts_certified⟩

