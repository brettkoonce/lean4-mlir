    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert8e2 : CertifiedAtLinf3 net ((2:ℝ)/255) img8 5 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box8e2).1, (box8e2).2,
    (pool8e2).1, (pool8e2).2]
