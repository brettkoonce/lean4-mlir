/-- **Certified at ε = 1/255** (MNIST test image #9, class 9): EVERY
    pixel-`L∞` perturbation of size ≤ 1/255 leaves class 9 the strict argmax of
    the conv net — conv, max-pool and a dense head, four layers. -/
theorem cert9e1 : CertifiedAtLinf3 net ((1:ℝ)/255) img9 9 := by
  refine ibp3_certified_of_boxSound net_boxSound ?_
  intro j hj
  simp only [netLo, netHi, (box9e1).1, (box9e1).2,
    (pool9e1).1, (pool9e1).2]
  fin_cases j <;>
    first
    | exact absurd rfl hj
    | · simp only [denseTLo, denseTHi]
        simp [Wd, bd, plo9e1, phi9e1, Fin.sum_univ_succ]
        try norm_num

