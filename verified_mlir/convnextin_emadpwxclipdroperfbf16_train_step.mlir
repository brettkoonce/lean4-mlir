    %v18 = stablehlo.subtract %v11, %v17 : tensor<64x3136x96xf32>
    %v19 = stablehlo.multiply %v18, %v18 : tensor<64x3136x96xf32>
    %v20 = stablehlo.reduce(%v19 init: %v12) applies stablehlo.add across dimensions = [2] : (tensor<64x3136x96xf32>, tensor<f32>) -> tensor<64x3136xf32>
    %v21 = stablehlo.broadcast_in_dim %v20, dims = [0, 1] : (tensor<64x3136xf32>) -> tensor<64x3136x96xf32>
    %v22 = stablehlo.divide %v21, %v13 : tensor<64x3136x96xf32>
    %v23 = stablehlo.add %v22, %v14 : tensor<64x3136x96xf32>
    %v24 = stablehlo.rsqrt %v23 : tensor<64x3136x96xf32>
    %v25 = stablehlo.multiply %v18, %v24 : tensor<64x3136x96xf32>
    %v26 = stablehlo.broadcast_in_dim %one, dims = [] : (tensor<f32>) -> tensor<64x3136x96xf32>
    %v27 = stablehlo.broadcast_in_dim %zero, dims = [] : (tensor<f32>) -> tensor<64x3136x96xf32>
    %v28 = stablehlo.multiply %v25, %v26 : tensor<64x3136x96xf32>
