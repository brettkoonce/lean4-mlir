    %sc = stablehlo.constant dense<0.0> : tensor<f32>
    %bsc = stablehlo.constant dense<64.0> : tensor<64x1000xf32>
    // The channel-LN chain normalises with lnRowF at γ=1/β=0 and applies the REAL
