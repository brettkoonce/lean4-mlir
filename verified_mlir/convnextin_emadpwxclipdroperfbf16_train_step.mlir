      {batch_group_count = 1 : i64, feature_group_count = 1 : i64} : (tensor<64x3x224x224xbf16>, tensor<96x3x4x4xbf16>) -> tensor<64x96x56x56xbf16>
    %v4 = stablehlo.convert %v3 : (tensor<64x96x56x56xbf16>) -> tensor<64x96x56x56xf32>
    %v5 = stablehlo.broadcast_in_dim %psb, dims = [1] : (tensor<96xf32>) -> tensor<64x96x56x56xf32>
    %v6 = stablehlo.add %v4, %v5 : tensor<64x96x56x56xf32>
    %v7 = stablehlo.reshape %v6 : (tensor<64x96x56x56xf32>) -> tensor<64x301056xf32>
    %v8 = stablehlo.reshape %v7 : (tensor<64x301056xf32>) -> tensor<64x96x3136xf32>
    %v9 = stablehlo.transpose %v8, dims = [0, 2, 1] : (tensor<64x96x3136xf32>) -> tensor<64x3136x96xf32>
