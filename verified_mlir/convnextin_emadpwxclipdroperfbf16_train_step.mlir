    %v1 = stablehlo.convert %v0 : (tensor<64x3x224x224xf32>) -> tensor<64x3x224x224xbf16>
    %v2 = stablehlo.convert %psW : (tensor<96x3x4x4xf32>) -> tensor<96x3x4x4xbf16>
    %v3 = stablehlo.convolution(%v1, %v2)
