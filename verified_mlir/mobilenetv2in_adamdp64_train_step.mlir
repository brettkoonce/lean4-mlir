    %v7 = stablehlo.constant dense<802816.0> : tensor<32xf32>
    %v8 = stablehlo.reduce(%v5 init: %v6) applies stablehlo.add across dimensions = [0, 2, 3] : (tensor<64x32x112x112xf32>, tensor<f32>) -> tensor<32xf32>
