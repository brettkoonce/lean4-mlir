    %v3 = stablehlo.add %v1, %v2 : tensor<64x64x80x80xf32>
    %v4 = stablehlo.reshape %v3 : (tensor<64x64x80x80xf32>) -> tensor<64x409600xf32>
    %v5 = stablehlo.reshape %v4 : (tensor<64x409600xf32>) -> tensor<64x64x80x80xf32>
