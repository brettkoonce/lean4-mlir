    %v30 = stablehlo.add %v28, %v29 : tensor<128x64x112x112xf32>
    %v31 = stablehlo.rsqrt %v30 : tensor<128x64x112x112xf32>
    %v32 = stablehlo.subtract %v24, %v27 : tensor<128x64x112x112xf32>
