    %sc = stablehlo.constant dense<0.0> : tensor<f32>
    %bsc = stablehlo.constant dense<32.0> : tensor<32x1000xf32>
    // §2m: the channel-LN chain normalises with lnRowF at γ=1/β=0 and applies the REAL
