    %v2 = stablehlo.convert %sW : (tensor<32x3x3x3xf32>) -> tensor<32x3x3x3xbf16>
    %v3 = stablehlo.convolution(%v1, %v2)
      dim_numbers = [b, f, 0, 1]x[o, i, 0, 1]->[b, f, 0, 1],
      window = {stride = [2, 2], pad = [[0, 1], [0, 1]], lhs_dilate = [1, 1], rhs_dilate = [1, 1]}
      {batch_group_count = 1 : i64, feature_group_count = 1 : i64} : (tensor<64x3x224x224xbf16>, tensor<32x3x3x3xbf16>) -> tensor<64x32x112x112xbf16>
    %v4 = stablehlo.convert %v3 : (tensor<64x32x112x112xbf16>) -> tensor<64x32x112x112xf32>
    %v5 = stablehlo.broadcast_in_dim %zb32, dims = [1] : (tensor<32xf32>) -> tensor<64x32x112x112xf32>
    %v6 = stablehlo.add %v4, %v5 : tensor<64x32x112x112xf32>
    %v7 = stablehlo.reshape %v6 : (tensor<64x32x112x112xf32>) -> tensor<64x401408xf32>
    %v8 = stablehlo.reshape %v7 : (tensor<64x401408xf32>) -> tensor<64x32x112x112xf32>
    %v9 = stablehlo.constant dense<0.0> : tensor<f32>
    %v10 = stablehlo.constant dense<802816.0> : tensor<64x32x112x112xf32>
    %v11 = stablehlo.constant dense<1.0e-5> : tensor<64x32x112x112xf32>
    %v12 = stablehlo.reduce(%v8 init: %v9) applies stablehlo.add across dimensions = [0, 2, 3] : (tensor<64x32x112x112xf32>, tensor<f32>) -> tensor<32xf32>
    %v13 = stablehlo.broadcast_in_dim %v12, dims = [1] : (tensor<32xf32>) -> tensor<64x32x112x112xf32>
