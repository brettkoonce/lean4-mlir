    %v10 = stablehlo.constant dense<802816.0> : tensor<32xf32>
    %v11 = stablehlo.reduce(%v8 init: %v9) applies stablehlo.add across dimensions = [0, 2, 3] : (tensor<64x32x112x112xf32>, tensor<f32>) -> tensor<32xf32>
