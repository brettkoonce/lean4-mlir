    %v20 = stablehlo.reduce(%v19 init: %v12) applies stablehlo.add across dimensions = [2] : (tensor<128x197x768xf32>, tensor<f32>) -> tensor<128x197xf32>
    %v21 = stablehlo.broadcast_in_dim %v20, dims = [0, 1] : (tensor<128x197xf32>) -> tensor<128x197x768xf32>
